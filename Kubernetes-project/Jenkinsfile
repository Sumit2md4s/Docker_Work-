pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                echo "Checking out source code..."
                checkout scm
            } 
        }
        stage('Build') {
            steps {
                echo "Installing Python dependencies..."
                sh '''
		python3 -m venv .venv
                .venv/bin/pip install -r app/requirement.txt
		.venv/bin/python --version
                '''
            }
        }
        
        stage('Test') {
            steps {
                echo "Running test ..."
                sh '.venv/bin/python -m py_compile app/app.py'
            }
        }
    }
}
