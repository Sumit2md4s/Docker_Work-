pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                echo "Checking out source code..."
                checkout scm
            } 
        }
        stage('Build') {
            steps {
                echo "Installing Python dependencies..."
                sh '''
                pip3 install -r app/requirement.txt
                '''
            }
        }
        
        stage('Test') {
            steps {
                echo "Running test ..."
                sh 'python3 -m py_compile app/app.py'
            }
        }
    }
}
