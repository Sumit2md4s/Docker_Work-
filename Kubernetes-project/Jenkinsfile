pipeline {
    agent any

    environment {
        IMAGE_NAME = "sumit2md4s/python-app"
        IMAGE_TAG  = "${IMAGE_NAME}:${BUILD_NUMBER}"
    }

    stages {

        // =========================================================
        // 1. CHECKOUT
        // =========================================================
        stage('Checkout') {
            steps {
                echo "Checking out source code..."

                checkout scm
            }
        }


        // =========================================================
        // 2. BUILD
        // =========================================================
        stage('Build') {
            steps {
                echo "Installing Python dependencies..."

                sh '''
                    python3 -m venv .venv

                    .venv/bin/pip install \
                        -r Kubernetes-project/app/requirement.txt

                    .venv/bin/python --version

                    echo "Build completed successfully"
                '''
            }
        }


        // =========================================================
        // 3. TEST
        // =========================================================
        stage('Test') {
            steps {
                echo "Running application test..."

                sh '''
		rm -rf Kubernetes-project/app/__pycache__

                    .venv/bin/python -m py_compile \
                        Kubernetes-project/app/app.py

			rm -rf Kubernetes-project/app/__pycache__

                    echo "Test completed successfully"
                '''
            }
        }

	stage('Test Sonar Authentication') {
    steps {
        withSonarQubeEnv('sonarqube') {
            withCredentials([
                string(credentialsId: 'sonar_token', variable: 'SONAR_TOKEN')
            ]) {
                sh '''
                    echo "Testing SonarQube authentication..."

                    curl -sS \
                        -u "$SONAR_TOKEN:" \
                        "$SONAR_HOST_URL/api/authentication/validate"

                    echo
                '''
            }
        }
    }
}


        // =========================================================
        // 4. SONARQUBE ANALYSIS
        // =========================================================
        stage('SonarQube Analysis') {
            steps {

                withSonarQubeEnv('sonarqube') {

                    withCredentials([
                        string(
                            credentialsId: 'sonar_token',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {

                        sh '''
                            cd Kubernetes-project

                            /opt/sonar-venv/bin/pysonar \
                                --sonar-host-url "$SONAR_HOST_URL" \
                                --sonar-token "$SONAR_TOKEN" \
                                --sonar-project-key "python-app"
                        '''
                    }
                }
            }
        }


        // =========================================================
        // 5. SONARQUBE QUALITY GATE
        // =========================================================
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }


        // =========================================================
        // 6. DOCKER BUILD
        // =========================================================
        stage('Docker Build') {
            steps {
                echo "Building Docker image..."

                sh '''
                    docker build \
                        -f Kubernetes-project/docker/dockerfile \
                        -t $IMAGE_TAG \
                        Kubernetes-project
                '''
            }
        }


        // =========================================================
        // 7. DOCKER PUSH
        // =========================================================
        stage('Docker Push') {
            steps {
                echo "Pushing Docker image to Docker Hub..."

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "$DOCKER_PASSWORD" | \
                            docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                        docker push $IMAGE_TAG

                        docker logout
                    '''
                }
            }
        }


        // =========================================================
        // 8. DEPLOY TO KUBERNETES
        // =========================================================
        stage('Deploy to Kubernetes') {
            steps {
                echo "Deploying application to Kubernetes..."

                sh '''
                    echo "Applying Kubernetes manifests..."

                    kubectl apply -f Kubernetes-project/k8/configMap.yaml
                    kubectl apply -f Kubernetes-project/k8/cronjob.yaml
                    kubectl apply -f Kubernetes-project/k8/ingress.yaml
                    kubectl apply -f Kubernetes-project/k8/job.yaml
                    kubectl apply -f Kubernetes-project/k8/k8deployment.yaml
                    kubectl apply -f Kubernetes-project/k8/pvc.yaml
                    kubectl apply -f Kubernetes-project/k8/rbac.yaml
                    kubectl apply -f Kubernetes-project/k8/secret.yaml
                    kubectl apply -f Kubernetes-project/k8/service.yaml

                    echo "Updating application image..."

                    kubectl set image deployment/k8-deployment \
                        pythonapp-cont=$IMAGE_TAG \
                        -n default

                    echo "Waiting for rollout..."

                    kubectl rollout status deployment/k8-deployment \
                        -n default \
                        --timeout=120s
                '''
            }
        }


        // =========================================================
        // 9. VERIFY DEPLOYMENT
        // =========================================================
        stage('Verify Deployment') {
            steps {
                echo "Verifying Kubernetes deployment..."

                sh '''
                    kubectl get deployment k8-deployment -n default

                    kubectl get pods -n default

                    kubectl get service -n default
                '''
            }
        }

   }
	post {
	   success {
	        echo "Pipeline completed successfully"
		}

           failure {
	        echo "Pipeline failed"
		}
           always {
	        echo "Pipeline finished"
		}
         }
    
}
