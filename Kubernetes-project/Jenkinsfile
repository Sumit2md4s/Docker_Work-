pipeline {
    agent any

    environment {
        IMAGE_NAME = "sumit2md4s/python-app"
        IMAGE_TAG  = "${IMAGE_NAME}:${BUILD_NUMBER}"
    }

    stages {

        // =========================================================
        // 1. CHECKOUT
        // =========================================================
        stage('Checkout') {
            steps {
                echo "Checking out source code..."

                checkout scm
            }
        }


        // =========================================================
        // 2. BUILD
        // =========================================================
        stage('Build') {
            steps {
                echo "Installing Python dependencies..."

                sh '''
                    python3 -m venv .venv

                    .venv/bin/pip install \
                        -r Kubernetes-project/app/requirement.txt

                    .venv/bin/python --version

                    echo "Build completed successfully"
                '''
            }
        }


        // =========================================================
        // 3. TEST
        // =========================================================
        stage('Test') {
            steps {
                echo "Running application test..."

                sh '''
                    .venv/bin/python -m py_compile \
                        Kubernetes-project/app/app.py

                    echo "Test completed successfully"
                '''
            }
        }


        // =========================================================
        // 4. SONARQUBE ANALYSIS
        // =========================================================
        stage('SonarQube Analysis') {
            steps {

                withSonarQubeEnv('sonarqube') {

                    withCredentials([
                        string(
                            credentialsId: 'sonar-token',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {

                        sh '''
                            cd Kubernetes-project

                            /opt/sonar-venv/bin/pysonar \
                                --sonar-host-url "$SONAR_HOST_URL" \
                                --sonar-token "$SONAR_TOKEN" \
                                --sonar-project-key "python-app"
                        '''
                    }
                }
            }
        }


        // =========================================================
        // 5. DOCKER BUILD
        // =========================================================
        stage('Docker Build') {
            steps {
                echo "Building Docker image..."

                sh '''
                    docker build \
                        -f Kubernetes-project/docker/dockerfile \
                        -t $IMAGE_TAG \
                        Kubernetes-project
                '''
            }
        }


        // =========================================================
        // 6. DOCKER PUSH
        // =========================================================
        stage('Docker Push') {
            steps {
                echo "Pushing Docker image to Docker Hub..."

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "$DOCKER_PASSWORD" | \
                            docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                        docker push $IMAGE_TAG

                        docker logout
                    '''
                }
            }
        }


        // =========================================================
        // 7. DEPLOY TO KUBERNETES
        // =========================================================
        stage('Deploy to Kubernetes') {
            steps {
                echo "Deploying application to Kubernetes..."

                sh '''
                    kubectl set image deployment/k8-deployment \
                        pythonapp-cont=$IMAGE_TAG \
                        -n default

                    kubectl rollout status deployment/k8-deployment \
                        -n default \
                        --timeout=120s
                '''
            }
        }


        // =========================================================
        // 8. VERIFY DEPLOYMENT
        // =========================================================
        stage('Verify Deployment') {
            steps {
                echo "Verifying Kubernetes deployment..."

                sh '''
                    kubectl get deployment k8-deployment -n default

                    kubectl get pods -n default

                    kubectl get service -n default
                '''
            }
        }
    }
}
